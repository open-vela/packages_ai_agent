config EXAMPLES_AI_AGENT_VELA
	tristate "Vela AI Agent"
	default n
	---help---
		Enable the AI Agent ported to Vela/NuttX.
		Requires network connectivity and mbedTLS.

if EXAMPLES_AI_AGENT_VELA

config EXAMPLES_AI_AGENT_VELA_PROGNAME
	string "Program name"
	default "ai_agent"
	---help---
		Name of the NSH built-in command.

config EXAMPLES_AI_AGENT_VELA_PRIORITY
	int "Agent task priority"
	default 100

config EXAMPLES_AI_AGENT_VELA_STACKSIZE
	int "Agent main stack size"
	default 32768

config EXAMPLES_AI_AGENT_VELA_DATA_DIR
	string "Persistent data directory"
	default "/data/ai_agent"
	---help---
		Base directory for config, memory and session files.
		Must be on a writable filesystem (e.g. littlefs, romfs+ramdisk).

config EXAMPLES_AI_AGENT_VELA_NODE_ID
	string "Node client ID"
	default "watch-01"
	---help---
		Unique identifier for this device when connecting to an
		OpenClaw Gateway as a Node. Used in tool names like
		node:<id>:<command>.

config EXAMPLES_AI_AGENT_VELA_NODE_DISPLAY_NAME
	string "Node client display name"
	default "Smart Watch"
	---help---
		Human-readable name shown on the Hub side for this Node.

choice
	prompt "Shell security policy"
	default EXAMPLES_AI_AGENT_VELA_SHELL_ALLOWLIST
	---help---
		Security policy for run_shell tool execution.
		- Allowlist: Only pre-approved commands (safest for production)
		- Full: Allow most commands except critical ones (for development/skills)
		- Deny: Disable run_shell completely

config EXAMPLES_AI_AGENT_VELA_SHELL_ALLOWLIST
	bool "Allowlist mode (production)"
	---help---
		Only allow pre-approved safe commands. Blocks shell meta-characters
		(pipes, redirects, etc.) and dangerous commands (rm, reboot, etc.).
		Recommended for production deployments.

config EXAMPLES_AI_AGENT_VELA_SHELL_FULL
	bool "Full mode (development)"
	---help---
		Allow most shell commands and features (pipes, redirects, etc.).
		Only blocks critical system commands (reboot, mkfs, insmod, etc.).
		Recommended for development and skill authoring.

config EXAMPLES_AI_AGENT_VELA_SHELL_DENY
	bool "Deny mode (disabled)"
	---help---
		Completely disable run_shell tool. Use when shell access is not needed.

endchoice

config AI_AGENT_LVGL_UI
	bool "Enable LVGL UI channel"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Enable the LVGL-based chat UI channel for AI Agent.
		Provides a chat-bubble interface on a round watch screen
		with PTT (Push-to-Talk) voice input.

config AI_AGENT_UI_RPMSG
	bool "Drive the CP-side UI over RPMsg (路 B dual-core)"
	default n
	depends on RPTUN
	---help---
		On dual-core BK7258 (路 B): the AP runs the agent (LLM/voice/
		TLS) but has no LCD/LVGL/FPU.  This compiles a thin shim
		(ui_rpmsg_client.c) that implements the lvgl_ui_channel_* +
		lvgl_toast_* API as RPMsg messages to the CP core, which owns
		the LCD and renders the bubbles/toasts (ui_rpmsg_server.c).
		The agent's call sites are unchanged (same guard as
		AI_AGENT_LVGL_UI).  TTS still runs locally on AP via
		voice_channel_speak(); only the bubble render crosses the link.

config AI_AGENT_PTT
	bool "Physical Push-to-Talk button (hold-to-talk)"
	default n
	depends on INPUT_BUTTONS
	depends on AI_AGENT_LVGL_UI || AI_AGENT_UI_RPMSG
	---help---
		Compile the AP-side physical PTT button thread (ptt_button.c).
		Opens /dev/btn0 and watches the configured button (S1 by default)
		for press/release edges: press → voice_channel_start() +
		set_ptt(RECORDING); release → set_ptt(PROCESSING) +
		voice_channel_stop_with_text() + send_user() echo +
		voice_channel_dispatch() → agent → LLM → reply + set_ptt(IDLE).
		Hold-to-talk semantics (UI方案.md §2.5).  No reverse RPMsg —
		the buttons, voice pipeline, and UI shim are all on the AP core.

config AI_AGENT_PTT_BUTTON_IDX
	int "PTT button index (0=S1/KEY1, 1=S2/KEY2, 2=S3/KEY3)"
	default 0
	depends on AI_AGENT_PTT

config AI_AGENT_PTT_DEVPATH
	string "PTT button device path"
	default "/dev/btn0"
	depends on AI_AGENT_PTT

config AI_AGENT_PTT_STACKSIZE
	int "PTT button thread stack size"
	default 4096
	depends on AI_AGENT_PTT

config AI_AGENT_PTT_PRIORITY
	int "PTT button thread priority"
	default 100
	depends on AI_AGENT_PTT

config AI_AGENT_PTT_ASR_CAP
	int "ASR text buffer capacity (bytes)"
	default 512
	depends on AI_AGENT_PTT

config AI_AGENT_FEISHU
	bool "Enable Feishu bot channel"
	default y
	---help---
		Enable the Feishu (Lark) bot channel. Uses WebSocket
		long-polling with TLS. Costs ~108KB RAM when active
		(20KB thread + 64KB frame buf + 20KB TLS context).
		Disable to save memory if only using CLI.

config AI_AGENT_WEIXIN
	bool "Enable WeChat channel"
	default y
	---help---
		Enable the WeChat (weixin) channel. Uses HTTPS
		long-polling. Costs ~45KB RAM at peak (12KB thread
		+ 32KB response buffer). Disable to save memory.

config AI_AGENT_MQTT
	bool "Enable MQTT channel"
	default y
	---help---
		Enable the MQTT pub/sub channel. Costs ~15KB RAM
		(12KB thread + 2KB buffers). Disable to save memory.

config AI_AGENT_AUDIO_PREPROCESS
	bool "Enable audio preprocessing (NS + AGC)"
	default n
	depends on BES_AEC
	---help---
		Enable noise suppression and automatic gain control
		on captured audio before sending to ASR. Uses BES
		ec2float for NS and compexp for AGC. Requires ~150KB
		heap on BES platforms with HiFi4 DSP.

config AI_AGENT_AUDIO_CAPTURE_GAIN
	int "Audio capture gain multiplier"
	default 6
	range 1 256
	---help---
		Gain multiplier applied to captured audio samples.
		Two use cases:
		- Multi-mic downmix: when the board configures several DMIC
		  channels but only one has a physical mic, the mono downmix
		  dilutes the signal (e.g. 6 = compensate 6-channel DMIC with
		  1 active mic).
		- QEMU/goldfish: the host mic level depends on which
		  PulseAudio source the virtio-snd capture binds to.  A
		  Bluetooth HFP headset source is already 16kHz mono s16le at
		  normal mic level, so no gain is needed (1 = passthrough).
		  Only raise this if a specific host source is measurably too
		  quiet.
		- 1 = No gain; higher values amplify more (may clip; saturated).

config AI_AGENT_AUDIO_ALSA_DIRECT
	bool "Use direct ALSA capture backend"
	default n
	---help---
		Capture audio directly through the ALSA (aw-alsa-lib) PCM
		interface instead of the portable media_recorder backend.
		This requires chip-specific ALSA headers and the Allwinner
		R528 rtos-hal include tree, so it only builds on boards that
		ship that SDK. Leave disabled (the default) on all other
		boards; the agent then uses the media framework recorder,
		which works everywhere. When enabled, the agent still falls
		back to media_recorder at runtime if ALSA capture fails.

config AI_AGENT_AUDIO_NUTTX_DIRECT
	bool "Use direct NuttX audio backend (pcm0c capture + pcm0p playback)"
	default n
	depends on AUDIO
	---help---
		Fallback audio backend for boards that have NuttX audio
		lower-halves but no media server (e.g. BK7258 /dev/audio/pcm0c
		and /dev/audio/pcm0p): capture via open/ioctl/read and playback
		via open/ioctl/enqueue. The media_recorder / media_player
		backends are always tried first; this path is only taken when
		they are unavailable, so leave it off on boards that run the
		media framework (e.g. qemu goldfish).

config AI_AGENT_CAMERA
	bool "Enable camera capture tool"
	default n
	depends on VIDEO
	---help---
		Enable the camera_capture tool for taking photos via
		V4L2 and analyzing them with Vision LLM. Requires a
		camera device at /dev/video0. Use for object recognition,
		text reading, and scene description.

config AI_AGENT_NODE
	bool "Enable Hub-Node cross-device protocol"
	default y
	---help---
		Enable the Node client and Node manager for cross-device
		tool invocation via OpenClaw Gateway. Costs ~20KB RAM
		(threads + WebSocket buffers). Disable on standalone
		devices that don't need multi-device coordination.

config AI_AGENT_MCP
	bool "Enable MCP tool bridge"
	default y
	---help---
		Enable the Model Context Protocol bridge for remote
		tool servers. Costs ~10KB RAM (registry + client state).
		Disable to save memory if only using builtin tools.

config AI_AGENT_REMOTE_CTRL
	bool "Enable remote agent control channel"
	default n
	depends on NETUTILS_MQTTC && NETUTILS_CJSON
	---help---
		Let this device drive a remote ACP agent (mimocode or
		kiro-cli) running on a PC, over a bridge that speaks MQTT
		to the device. Adds the remote_agent_prompt and
		remote_agent_status tools, the set_remote* config commands
		and the r* console commands (rask, rstat, rreply, rusage,
		ronce, rdeny).

		Costs ~22KB RAM (12KB thread + 2x4.6KB MQTT buffers +
		session state). Needs its own MQTT client, separate from
		the AI_AGENT_MQTT chat channel, because each reconnect must
		mint a new session nonce and redo the handshake.

		Permission decisions for the remote agent are reachable only
		from the NSH commands, never as an LLM-callable tool.

		Broker address and credentials are supplied at runtime
		through the config store (remote_broker, remote_username,
		remote_password) and are never compiled in.

config AI_AGENT_TEST
	bool "Enable integration test commands"
	default n
	---help---
		Compile the claw_test CLI command and vision integration test
		harness. Adds ~2KB code. Use 'claw_test' in NSH to run tests.

config AI_AGENT_TEST_IMAGE_DIR
	string "Test image directory"
	default "/data/ai_agent/test"
	depends on AGENT_TEST
	---help---
		Directory for test images used by the vision integration tests.
		Images can be pre-pushed via adb or generated at runtime.
		Must be on a writable filesystem.

config AI_AGENT_NET_RPMSG
	bool "Use RPMSG/TUN network (no Wi-Fi)"
	default n
	---help---
		Use RPMSG usrsock or TUN device for network connectivity
		instead of Wi-Fi. For boards without onboard Wi-Fi that
		rely on BLE proxy to a phone for internet access.
		Enables configurable timeouts, retry logic, BLE state
		bridging, and resource guards suited for high-latency
		BLE proxy links.

config AI_AGENT_SKILL_SYNC
	bool "Enable Bitable skill sync"
	default n
	---help---
		Pull skills from a Feishu Bitable (multi-dimensional table)
		at startup after network is connected. Requires Feishu app
		credentials to be configured.

if AGENT_SKILL_SYNC

config AI_AGENT_SKILL_SYNC_APP_TOKEN
	string "Bitable app_token"
	default ""
	---help---
		The app_token of the Feishu Bitable that stores skills.
		Found in the Bitable URL: /base/<app_token>

config AI_AGENT_SKILL_SYNC_TABLE_ID
	string "Bitable table_id"
	default ""
	---help---
		The table_id within the Bitable that contains skill records.

config AI_AGENT_SKILL_SYNC_MODE
	int "Sync mode (0=incremental, 1=full)"
	default 0
	---help---
		0 = Incremental: only update skills whose version changed.
		1 = Full: rewrite all skills and remove orphaned local ones.

config AI_AGENT_SKILL_SYNC_DEVICE_TYPE
	string "Device type for target_device filter"
	default "all"
	---help---
		Device type used to filter skills by target_device field.
		Skills with target_device containing this value or "all"
		will be synced. Examples: watch, band, glasses, speaker.

endif

config AI_AGENT_MCP_MAX_SERVERS
	int "Max MCP remote servers"
	default 4
	range 1 8
	depends on AI_AGENT_MCP
	---help---
		Maximum number of remote MCP servers. Each server slot
		uses ~456 bytes BSS. Reduce on memory-constrained boards.

config AI_AGENT_MCP_MAX_TOOLS
	int "Max MCP remote tools"
	default 16
	range 4 64
	depends on AI_AGENT_MCP
	---help---
		Maximum cached remote tools across all MCP servers.
		Each tool slot uses ~452 bytes BSS. Reduce on
		memory-constrained boards.

config AI_AGENT_TLS_CONN_POOL_SIZE
	int "TLS connection pool size"
	default 2
	range 1 4
	---help---
		Number of persistent TLS connections kept alive for
		reuse. Each slot uses ~12KB BSS (TLS context + raw
		buffer). Set to 1 on memory-constrained boards.

config AI_AGENT_WS_SERVER
	bool "WebSocket server channel"
	default y
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		Run the local WebSocket server (port 8080 style console).
		Disable on small-RAM targets: the accept thread needs its
		own TLS-sized stack and pushes the heap over the edge
		after the agent loop's buffers are allocated.  Boards that
		reach their LLM over MQTT or Feishu do not need it.

config AI_AGENT_TOOLS_WEARABLE
	bool "Wearable sensor tools (battery/wear/screen/heartrate/steps/vibrate)"
	default y
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		Register the wearable sensor tool group.  Disable on boards
		without the corresponding sensors; each registered tool
		costs heap in the registry and the tools JSON.

config AI_AGENT_TOOLS_MEDIA
	bool "Music control tools"
	default y
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		Register the music playback tool group.  Disable on boards
		without a media player.

config AI_AGENT_TOOLS_QUICKAPP
	bool "QuickApp launch tools"
	default y
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		Register quickapp launch/exit tools.  Disable on boards
		without the quickapp runtime.

config AI_AGENT_NOTIFY_SERVICE
	bool "Enable Gerrit/Jira notify polling → LVGL toast"
	default n
	depends on AI_AGENT_LVGL_UI || AI_AGENT_UI_RPMSG
	depends on AI_AGENT_MCP
	---help---
		Background polling service that periodically queries
		connected Gerrit/Jira MCP servers for new changes,
		deduplicates against a persisted cursor, and pops a
		top-of-screen LVGL toast for each new item (does NOT
		enter chat history). Requires LVGL UI + MCP client.

config AI_AGENT_NOTIFY_INTERVAL_SEC
	int "Notify polling interval (seconds)"
	default 60
	range 30 3600
	depends on AI_AGENT_NOTIFY_SERVICE
	---help---
		Base polling interval in seconds. Each source (gerrit/
		jira) keeps its own next-due timestamp staggered off
		this base. Too low hammers internal MCP gateways; too
		-high misses fresh CI failures. 60 is a sane default.

config AI_AGENT_NOTIFY_LLM_SUMMARY
	bool "Summarize new items via LLM (off = template text)"
	default n
	depends on AI_AGENT_NOTIFY_SERVICE
	---help---
		If on, new Gerrit/Jira items are pushed as a prompt to
		agent_loop so the LLM summarizes them before showing the
		toast. Costs tokens + ~2-5s latency per batch. Off (default)
		uses a fast snprintf template ("Gerrit #N: subject").

config AI_AGENT_BLE_GATT
	bool "Enable BLE GATT data channel"
	default n
	---help---
		Enable BLE GATT data channel using Nordic UART Service
		(NUS) pattern. Provides bidirectional data exchange over
		BLE with any GATT client (iOS/Android). Works on BLE-only
		chips without classic Bluetooth SPP support.

config AI_AGENT_BLE_NET
	bool "Enable BLE SPP network proxy"
	default n
	---help---
		Enable BLE SPP + TUN based network proxy channel.
		Provides internet access via phone companion app over
		Bluetooth SPP. For devices without Wi-Fi.

config AI_AGENT_REST_API
	bool "Enable REST API endpoints"
	default n
	---help---
		Enable HTTP REST API endpoints accessible via WebSocket
		server for remote configuration, skill management, and
		log retrieval from Android companion App.

endif

#----------------------------------------------------------------------------
# CP-side UI renderer (路 B). Independent of EXAMPLES_AI_AGENT_VELA so the
# CP core can render the chat UI without pulling agent_main/llm/voice/TLS.
#----------------------------------------------------------------------------
config EXAMPLES_AI_AGENT_UI_CP
	bool "AI Agent UI (CP-side render only)"
	default n
	depends on GRAPHICS_LVGL
	---help---
	  CP-core UI renderer: builds only the LVGL chat-view assets
	  (lvgl_ui_channel + lvgl_toast + MiSans CJK font) into a
	  standalone NSH builtin, without agent_main/llm/voice/TLS.
	  voice_channel_* and message_bus are stubbed on this side (CP
	  only renders; TTS/ASR live on AP). Launch from CP NSH; the
	  AP->CP UI RPMsg endpoint will be wired in a follow-up slice.

# Defined at top-level (NOT inside `if EXAMPLES_AI_AGENT_VELA`) so it is
# selectable on the CP core, which builds under EXAMPLES_AI_AGENT_UI_CP
# without EXAMPLES_AI_AGENT_VELA.  On qemu/AP it is reachable via
# AI_AGENT_LVGL_UI / AI_AGENT_UI_RPMSG (which do sit inside the VELA
# block); the ap defconfig leaves it off because the AP has no LVGL.
config AI_AGENT_PET_STATUS
	bool "Pet status ring home screen (M7 差异化页, pure-LVGL 退路)"
	default n
	depends on AI_AGENT_LVGL_UI || AI_AGENT_UI_RPMSG || EXAMPLES_AI_AGENT_UI_CP
	---help---
	  Build pet_status_view.c: a round-screen "pet" home screen that mirrors
	  the agent's lifecycle state (idle/listening/thinking/executing/waiting/
	  error) via color + animation, as a 待机首屏.  Pure LVGL (the Rust/mirui
	  退路 from UI方案.md §2.4 when the no_std runtime is unavailable).
	  On dual-core (路 B) the CP renders it and the AP drives state over
	  RPMsg (UI_RPMSG_SET_PET_STATE); lvgl_ui_channel also mirrors PTT
	  state onto the pet and yields the foreground to the pet after chat
	  idle, so the pet "lives" during PTT without extra AP wiring.

config AI_AGENT_PARTICLE_FLOW
	bool "Particle flow visualizer (M7 差异化页 ②, pure-LVGL)"
	default n
	depends on AI_AGENT_LVGL_UI || AI_AGENT_UI_RPMSG || EXAMPLES_AI_AGENT_UI_CP
	---help---
	  Build particle_flow_view.c: a second round-screen 差异化 page — an
	  abstract "energy flow" of 18 particles swirling around a pulsing core,
	  distinct from the pet's face+ring. Particle color + flow direction +
	  core pulse mirror the same 6-state agent lifecycle (idle/listening/
	  thinking/executing/waiting/error). Pure LVGL with integer fixed-point
	  physics (no float / math.h), so it links on the CP without -Werror risk.
	  Reached via the set_page command (page 1) or a future idle auto-switch;
	  does not displace the pet home screen.

config AI_AGENT_STANDBY_UI
	bool "Standby dim digital clock (M7 待机界面)"
	default n
	depends on AI_AGENT_LVGL_UI || AI_AGENT_UI_RPMSG || EXAMPLES_AI_AGENT_UI_CP
	---help---
	  Build standby_view.c: a minimal dim digital clock (large HH:MM in
	  Montserrat 24 + date in MiSans 16 CJK + a "待机中" hint) that
	  lvgl_ui_channel.c fades in after 60s with no real activity (no chat
	  bubble, PTT, pet-state change, page switch, approval or scroll) and the
	  agent idle.  Any such activity wakes it and restores the previous
	  screen.  Runs on the same core that owns the local LVGL UI (AP on the
	  BK7258, or qemu single-core).

if EXAMPLES_AI_AGENT_UI_CP

config EXAMPLES_AI_AGENT_UI_CP_PROGNAME
	string "Program name"
	default "ai_agent_ui"

config EXAMPLES_AI_AGENT_UI_CP_PRIORITY
	int "UI task priority"
	default 100

config EXAMPLES_AI_AGENT_UI_CP_STACKSIZE
	int "UI task stack size"
	default 32768

endif
